    {
      "parameters": {
        "jsCode": "// Pick Template — random template per email\nconst templates = $('Get Templates').all().map(i => i.json);\n\nif (!templates.length) {\n  throw new Error('No templates in sheet');\n}\n\nconst t = templates[Math.floor(Math.random() * templates.length)];\nconst bodyHtml = (t.Body || '').replace(/\\n/g, '<br>');\n\nreturn [{\n  json: {\n    subject: t.Subject || '',\n    body: bodyHtml,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        128,
        48
      ],
      "id": "8740ce0d-5556-48dc-bf76-85f4a9fad768",
      "name": "Pick Template"
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Loop Over Items').item.json;\nconst sender = $('Pick Sender').item.json;\nconst template = items[0].json;\n\nreturn [{\n  json: {\n    ...lead,\n    Email: lead.Email,\n    Name: lead.Name,\n    subject: template.subject,\n    body: template.body,\n    sender_email: sender.Email,\n    App_Password: sender.App_Password,\n    Sent_Today: sender.Sent_Today,\n    Daily_Limit: sender.Daily_Limit,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        48
      ],
      "id": "1542eab1-a658-4159-921d-2faeead18c33",
      "name": "Combine all"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nlet subject = item.subject || '';\nlet body = item.body || '';\n\nbody = body.replace(/{Name}/g, item.Name || 'there');\nbody = body.replace(/{company}/g, item.Company || '');\n\nsubject = subject.replace(/{Name}/g, item.Name || 'there');\nsubject = subject.replace(/{company}/g, item.Company || '');\n\nreturn [{\n  json: {\n    ...item,\n    subject: subject,\n    body: body,\n  }\n}];"
      },
