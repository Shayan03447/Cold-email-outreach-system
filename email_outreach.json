      "parameters": {
        "jsCode": "const MAX=5\nconst rows=items.map(i => i.json)\nconst batch=rows.slice(0, MAX);\nif(batch.length===0){\n  return [];\n}\nreturn batch.map(json => ({json}))"
      },
